{
  "manifest_version": 3,
  "name": "FCUNO SPC WhatsApp Board",
  "version": "0.4.3",
  "description": "SPC Supplier/Buyer board plus sent enquiry sender for WhatsApp Web.",
  "permissions": ["storage", "notifications", "debugger"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["spc-sidebar-logo.png"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://spc.fcuno.com/*",
    "https://query1.finance.yahoo.com/*"
  ]
}
