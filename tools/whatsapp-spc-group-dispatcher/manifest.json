{
  "manifest_version": 3,
  "name": "FCUNO SPC Group Dispatcher",
  "version": "1.1.3",
  "description": "Dedicated SPC enquiry dispatcher for centrally assigned WhatsApp trading groups.",
  "permissions": ["storage", "debugger", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["spc-sidebar-logo.png"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://spc.fcuno.com/*"
  ]
}
