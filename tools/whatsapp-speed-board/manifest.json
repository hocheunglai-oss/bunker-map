{
  "manifest_version": 3,
  "name": "FCUNO WhatsApp Speed Board",
  "version": "0.8.0",
  "description": "Local Supplier and Buyer contact board plus enquiry worksheet sender for WhatsApp Web trading workflow.",
  "permissions": ["storage", "notifications", "debugger"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://fcuno.com/admin/enquiryworksheet*",
        "https://www.fcuno.com/admin/enquiryworksheet*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fc-uno-sidebar-logo.png"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://fcuno.com/*",
    "https://www.fcuno.com/*",
    "https://query1.finance.yahoo.com/*"
  ]
}
