{
  "name": "bunker-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "restart:dev": "sh ./scripts/restart-dev.sh",
    "build": "next build --webpack",
    "lint": "eslint app components lib",
    "test:parsers": "tsx --test tests/enquiry-parsers.test.ts",
    "test:security": "tsx --test tests/spc-auth-security.test.ts tests/spc-session-cookie-security.test.ts tests/spc-session-presentation.test.ts tests/spc-users-whatsapp-phone.test.ts tests/spc-actor-user-id-audit.test.ts tests/spc-login-rate-limit.test.ts tests/spc-login-route-security.test.ts tests/spc-security-maintenance.test.ts tests/spc-audit-context.test.ts tests/spc-audit-presentation.test.ts tests/spc-audit-route-enforcement.test.ts tests/spc-user-audit-sql.test.ts tests/spc-whatsapp-login-mfa.test.ts tests/spc-private-response-cache.test.ts tests/trusted-request-context.test.ts tests/web-security-baseline.test.ts tests/security-documentation.test.ts tests/spc-speedboard-update-notice.test.ts tests/brent-market-data.test.ts tests/outlook-graph-callback-security.test.ts tests/query-escaping-security.test.ts tests/codeql-regex-safety.test.ts tests/google-drive-upload-url-security.test.ts",
    "security:check": "npm run test:security && npm audit --omit=dev --audit-level=high",
    "security:check-live": "node scripts/check-live-security-baseline.mjs",
    "start": "next start",
    "release:check": "node scripts/release-check.mjs",
    "vercel-build": "next build --webpack",
    "auth:google-drive": "node scripts/auth-google-drive.mjs",
    "backup:drive-files:gcs": "node scripts/backup-google-drive-files-to-gcs.mjs",
    "drive:ccinfo-public": "node scripts/make-ccinfo-drive-files-public.mjs",
    "auth:google-contacts": "node scripts/auth-google-contacts.mjs",
    "auth:google-calendar": "node scripts/auth-google-calendar.mjs",
    "backup:validate": "node scripts/validate-backup.mjs",
    "backup:restore:recovery": "node scripts/restore-backup-to-recovery.mjs",
    "export:exchange-addressbook": "node scripts/export-exchange-addressbook.mjs",
    "outlook-templates:reconcile": "NODE_OPTIONS=--conditions=react-server tsx scripts/reconcile-outlook-template-recipients.ts",
    "uppercase:phonebook": "node scripts/uppercase-phonebook-data.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@supabase/supabase-js": "^2.110.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "googleapis": "^171.4.0",
    "leaflet": "^1.9.4",
    "next": "^16.3.0",
    "nodemailer": "^9.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "sanitize-html": "^2.17.6",
    "server-only": "^0.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/leaflet": "^1.9.21",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
