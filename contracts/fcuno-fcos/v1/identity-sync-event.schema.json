{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fcuno.com/contracts/fcuno-fcos/v1/identity-sync-event.schema.json",
  "title": "FCUNO identity synchronization event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "iss",
    "sub",
    "aud",
    "iat",
    "exp",
    "jti",
    "typ",
    "event_id",
    "event_type",
    "occurred_at",
    "identity"
  ],
  "properties": {
    "iss": { "const": "https://fcuno.com" },
    "sub": { "type": "string", "format": "uuid" },
    "aud": { "const": "fcos-identity-sync" },
    "iat": { "type": "integer", "minimum": 1 },
    "exp": { "type": "integer", "minimum": 1 },
    "jti": { "type": "string", "format": "uuid" },
    "typ": { "const": "fcuno.identity-sync+jwt" },
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "fcuno.identity.v1" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sub",
        "email",
        "email_verified",
        "username",
        "display_name",
        "is_active",
        "use_fcos",
        "use_spc",
        "identity_revision",
        "credential_revision",
        "revoked_before"
      ],
      "properties": {
        "sub": { "type": "string", "format": "uuid" },
        "email": { "type": "string", "format": "email", "maxLength": 320 },
        "email_verified": { "const": true },
        "username": { "type": "string", "minLength": 1, "maxLength": 320 },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "is_active": { "type": "boolean" },
        "use_fcos": { "type": "boolean" },
        "use_spc": { "type": "boolean" },
        "identity_revision": { "type": "integer", "minimum": 1 },
        "credential_revision": { "type": "integer", "minimum": 1 },
        "revoked_before": { "type": "string", "format": "date-time" }
      }
    }
  }
}
