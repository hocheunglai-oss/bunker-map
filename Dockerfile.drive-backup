FROM node:24-slim

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY scripts/backup-google-drive-files-to-gcs.mjs ./scripts/backup-google-drive-files-to-gcs.mjs
COPY scripts/backup-storage-media-to-gcs.mjs ./scripts/backup-storage-media-to-gcs.mjs
COPY scripts/lib/storage-media-*.mjs ./scripts/lib/
COPY scripts/lib/backup-budget-*.mjs ./scripts/lib/
COPY config/fcunoConnections.ts ./config/fcunoConnections.ts
COPY lib/storageMediaBackup.mjs lib/backupValidationSpool.mjs lib/storageMediaRecurring.mjs lib/storageMediaBackupHealth.mjs lib/backupOperatingPolicy.mjs ./lib/

CMD ["npm", "run", "backup:drive-files:gcs"]
